# Firebase Web App config (Authentication + Firestore only — both free for
# YOU to run on the Spark plan, no credit card needed; end users pay for
# credits separately via PayPal, see below) — create a project at
# https://console.firebase.google.com, then Project settings > General >
# Your apps > Web app, and copy the config values here.
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:xxxxxxxxxxxxx"

# In Firebase Console > Authentication > Sign-in method, enable the "Google" provider.
# In Authentication > Settings > Authorized domains, add your domain (e.g. r.is-cool.dev).

# Cloudinary (file storage — photos, grave photo, life-story audio). Free tier,
# no credit card required. Create an account at https://cloudinary.com, then:
#  - "Cloud name" is on your Dashboard homepage.
#  - Create an unsigned upload preset: Settings > Upload > Upload presets >
#    Add upload preset, set "Signing Mode" to "Unsigned", save, and copy its name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# Cloudflare Worker URL (see worker/README.md) — creating a memorial page and
# buying credits both go through this, since only it can verify payment /
# enforce the credit balance before writing to Firestore.
NEXT_PUBLIC_WORKER_URL="https://zikaron-worker.your-subdomain.workers.dev"

# PayPal REST app Client ID (public — safe to expose in the browser; the
# secret half lives only in the Worker). Create a LIVE REST API app at
# https://developer.paypal.com/dashboard/applications to get this.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-live-client-id"

# Public site URL (including base path), used to build absolute share links & QR codes
NEXT_PUBLIC_SITE_URL="https://r.is-cool.dev/zikaron"

# Base path the app is served under (leave empty to serve from the domain root)
NEXT_PUBLIC_BASE_PATH="/zikaron"

# Set to "true" to develop against `firebase emulators:start` instead of your
# real Firebase project (see README for local emulator setup)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="false"
