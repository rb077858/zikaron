rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && request.auth.uid == data.ownerId;
    }

    match /memorials/{memorialId} {
      // `resource == null` covers reads of a document that doesn't exist yet
      // — without it, `resource.data` errors on a null resource and the
      // read is denied, even though nothing sensitive is being exposed.
      allow read: if resource == null
        || resource.data.published == true
        || isOwner(resource.data);

      // Creating a memorial costs credits (or is free for the admin
      // account) — that can't be safely enforced from the browser (a client
      // could just skip the "pay" step), so only the trusted Cloudflare
      // Worker creates memorials, using its own service-account credentials
      // which bypass these rules entirely. Direct client writes are denied.
      allow create: if false;

      // Editing and deleting stay free, direct, owner-only operations —
      // no money involved, so no need to route them through the Worker.
      allow update: if isOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isOwner(resource.data);

      // Subcollection docs carry their own copies of `ownerId` and
      // `published` (denormalized from the parent memorial at write time).
      // This avoids cross-document get() lookups in rules, which choke on
      // the Hebrew-character document IDs this app uses for slugs.
      match /photos/{photoId} {
        allow read: if resource.data.published == true || isOwner(resource.data);

        allow create: if isOwner(request.resource.data)
          && request.resource.data.url is string;

        allow delete: if isOwner(resource.data);
      }

      match /candles/{candleId} {
        allow read: if resource.data.published == true || isOwner(resource.data);

        // Anyone (including guests) may light a virtual candle and sign the
        // tribute wall — the memorial's own ownerId/published are copied in
        // by the app when it already has the memorial loaded.
        allow create: if request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (request.resource.data.message == null || request.resource.data.message.size() <= 500)
          && request.resource.data.ownerId is string;

        allow delete: if isOwner(resource.data);
      }
    }

    // Credit balances. Only ever written by the trusted Cloudflare Worker
    // (via a Google service account, which bypasses these rules the same
    // way the Admin SDK would) — after it verifies a real PayPal payment,
    // or when it creates a memorial on the admin's behalf. The browser can
    // read its own balance but can never write it directly; otherwise
    // anyone could grant themselves free credits from dev tools.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
